{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "travelapp-31255",
          "appId": "1:531891096536:android:d15391c4766a4ea7d880ad",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "travelapp-31255",
          "configurations": {
            "android": "1:531891096536:android:d15391c4766a4ea7d880ad",
            "ios": "1:531891096536:ios:34641153670335add880ad",
            "macos": "1:531891096536:ios:34641153670335add880ad",
            "web": "1:531891096536:web:87028a0fda90d1aad880ad",
            "windows": "1:531891096536:web:e0b7a17ad2edb379d880ad"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "web_invite/public",
    "cleanUrls": true,
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/join/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; connect-src 'self' https://*.googleapis.com https://www.gstatic.com; img-src 'self' https: data:; style-src 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ]
  }
}
