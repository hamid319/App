# Copy to .env (git-ignored) and fill in. Only `npm run publish` needs these.
# R2 API token: "Object Read & Write", limited to the one bucket below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=swipetrip-places
# Public base URL of the bucket, e.g. https://img.swipetrip.app (no trailing slash)
R2_PUBLIC_BASE_URL=

# Free-tier guard: publish stops before the bucket would exceed this size
# or a run would upload more objects (defaults: 5 GB, 20000).
# R2_MAX_BUCKET_GB=5
# R2_MAX_UPLOADS_PER_RUN=20000

# Firestore access: either run `gcloud auth application-default login` once,
# or point this at a service-account key kept in .secrets/ (git-ignored).
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json
