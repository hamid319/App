rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: a user may only write the object named after their uid.
    // A full-segment wildcard is used so the match does not depend on
    // partial-segment pattern support.
    // Cached place photos. Written only by the ingestion Cloud Function via
    // the Admin SDK, which bypasses these rules.
    match /places/{placeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /profile_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }
  }
}
