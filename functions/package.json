{
  "name": "swipetrip-city-pipeline",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Server-only Wikimedia city collection pipeline for SwipeTrip",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/firestore.rules.test.ts",
    "test:rules": "vitest run test/firestore.rules.test.ts",
    "check": "npm run typecheck && npm test",
    "probe:wikimedia": "tsx scripts/probe-wikimedia.ts",
    "inspect": "tsx scripts/inspect-pipeline.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.15.30",
    "firebase-tools": "^15.30.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
