rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(groupData) {
      return isAuthenticated() && request.auth.uid == groupData.ownerUid;
    }

    function isMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.members;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    match /users/{userId} {
      // Read stays open to authenticated users because the group flow resolves
      // member profiles. Tighten to self-only once member names come from a
      // dedicated publicProfiles collection.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // uid must never be repointed at another account.
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Shared place cache. The client still writes it today; once the
    // ingestion Cloud Function owns these writes, set write to false.
    match /places/{placeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /placeCacheMetadata/{cityKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Solo-mode swipe history, private to its author.
    match /swipeResults/{resultId} {
      allow read, delete: if isAuthenticated()
                          && request.auth.uid == resource.data.userId;
      allow create, update: if isAuthenticated()
                            && request.auth.uid == request.resource.data.userId;
    }

    match /groups/{groupId} {
      // Readable by authenticated users so invite codes can be resolved.
      allow read: if isAuthenticated();

      // A creator may only create a group containing themselves.
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.resource.data.members.size() == 1
                    && request.auth.uid in request.resource.data.members;

      allow update: if isAuthenticated() && (
        // Owner can update anything (threshold, location, active session, ...)
        isOwner(resource.data) ||
        // A member may clear the active session when it finishes.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activeSessionId',
            'hasCompletedSession'
          ]) &&
          request.resource.data.activeSessionId == null
        ) ||
        // A member may refresh the shared-favourites projection.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sharedFavorites'
          ])
        ) ||
        // Joining: only the caller may be appended, and only themselves.
        (
          resource.data.joinEnabled == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        ) ||
        // Leaving: the caller may only remove themselves.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          !request.resource.data.members.hasAny([request.auth.uid]) &&
          resource.data.members.hasAll(request.resource.data.members)
        )
      );

      allow delete: if isOwner(resource.data);

      match /sessions/{sessionId} {
        allow read: if isMember(groupData(groupId));

        allow create: if isOwner(groupData(groupId));

        allow update: if isMember(groupData(groupId)) && (
          isOwner(groupData(groupId)) ||
          // A member records progress and may flip the session to completed.
          // recordSwipeInSession rewrites the whole document, so instead of
          // whitelisting keys we pin the fields that must never change.
          (
            request.resource.data.placePool == resource.data.placePool &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.sessionId == resource.data.sessionId
          )
        );

        allow delete: if isOwner(groupData(groupId));

        match /votes/{placeId} {
          allow read: if isMember(groupData(groupId));

          // Aggregate vote document. Members write the whole document, so the
          // shape is constrained here; per-user vote documents would allow a
          // stricter "only your own uid changed" rule.
          allow create, update: if isMember(groupData(groupId))
                                && request.resource.data.keys().hasOnly([
                                     'placeId',
                                     'likes',
                                     'dislikes',
                                     'likedBy',
                                     'dislikedBy'
                                   ]);
        }

        // Per-user swipe progress, private to its owner.
        match /userSwipes/{userId} {
          allow read: if isMember(groupData(groupId));
          allow write: if isMember(groupData(groupId))
                       && request.auth.uid == userId;
        }
      }
    }
  }
}
