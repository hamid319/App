rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(groupData) {
      return isAuthenticated() && request.auth.uid == groupData.ownerUid;
    }

    function isMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.members;
    }

    // Signed in with an account, not as a guest (anonymous auth).
    function isRegistered() {
      return isAuthenticated()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Shape of places/{placeId}/reviews/{uid}; text length matches
    // PlaceReview.maxTextLength.
    function isValidReview(placeId, uid) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'placeId', 'rating', 'text', 'authorName',
                                  'language', 'hidden', 'createdAt', 'updatedAt'])
             && data.uid == uid
             && data.placeId == placeId
             && data.rating is int && data.rating >= 1 && data.rating <= 5
             && data.text is string && data.text.size() <= 500
             && data.authorName is string && data.authorName.size() <= 80
             && data.language is string && data.language.size() <= 8
             && data.hidden is bool
             && data.updatedAt == request.time;
    }

    // The likes differ by exactly the caller's uid (added or removed).
    function onlyOwnUidToggled(before, after) {
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return added.union(removed).size() == 1
             && added.union(removed).hasOnly([request.auth.uid])
             && after.size() == after.toSet().size();
    }

    function isValidIdea(data) {
      return data.keys().hasOnly(['placeId', 'title', 'addedBy', 'likedBy', 'source', 'createdAt'])
             && data.keys().hasAll(['title', 'addedBy', 'likedBy', 'source', 'createdAt'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 120
             && (data.get('placeId', null) == null || data.placeId is string)
             && data.addedBy is string
             && data.likedBy is list
             && data.source in ['manual', 'swipe', 'link']
             && data.createdAt == request.time;
    }

    function isValidPoll(data) {
      return data.keys().hasOnly(['question', 'options', 'votes', 'createdBy', 'createdAt', 'closed'])
             && data.keys().hasAll(['question', 'options', 'votes', 'createdBy', 'createdAt', 'closed'])
             && data.question is string && data.question.size() > 0 && data.question.size() <= 140
             && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
             && data.votes is map
             && data.createdBy is string
             && data.closed is bool
             && data.createdAt == request.time;
    }

    function isValidExpense(data, group) {
      return data.keys().hasOnly(['title', 'amountCents', 'currency', 'paidBy', 'participants', 'createdBy', 'createdAt'])
             && data.keys().hasAll(['title', 'amountCents', 'currency', 'paidBy', 'participants', 'createdBy', 'createdAt'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 80
             && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000
             && data.currency == 'EUR'
             && data.paidBy is string && data.paidBy in group.members
             && data.participants is list && data.participants.size() > 0
             && group.members.hasAll(data.participants)
             && data.createdBy is string
             && data.createdAt is timestamp;
    }

    // Journal entry: text and/or up to 6 photos ({path, url, width, height}).
    function isValidJournalEntry(data) {
      return data.keys().hasOnly(['authorUid', 'day', 'text', 'photos', 'createdAt', 'updatedAt'])
             && data.keys().hasAll(['authorUid', 'day', 'text', 'photos', 'createdAt', 'updatedAt'])
             && data.authorUid is string
             && data.day is string && data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && data.text is string && data.text.size() <= 500
             && data.photos is list && data.photos.size() <= 6
             && (data.text.size() > 0 || data.photos.size() > 0)
             && data.updatedAt == request.time;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // The owner is the trip's last member: deleting their account clears
    // the trip, including what members who left had created.
    function isSoleOwner(groupId) {
      let group = groupData(groupId);
      return isOwner(group) && group.members.size() == 1;
    }

    match /users/{userId} {
      // Read stays open to authenticated users because the group flow resolves
      // member profiles. Tighten to self-only once member names come from a
      // dedicated publicProfiles collection.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // uid must never be repointed at another account.
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Shared place cache. The client still writes it today; once the
    // ingestion Cloud Function owns these writes, set write to false.
    match /places/{placeId} {
      allow read: if isAuthenticated();
      // Curated places (source "wikidata") are written only by the import
      // tool with admin credentials; the legacy client cache may still
      // write its own documents.
      allow create: if isAuthenticated()
                    && request.resource.data.get('source', '') != 'wikidata';
      allow update: if isAuthenticated()
                    && resource.data.get('source', '') != 'wikidata'
                    && request.resource.data.get('source', '') != 'wikidata';
      allow delete: if isAuthenticated()
                    && resource.data.get('source', '') != 'wikidata';

      // One review per signed-in (non-guest) user, under their uid. Others
      // may only hide a review by reporting it; moderators clear the flag
      // or delete the review in the Firebase console.
      match /reviews/{uid} {
        allow read: if isAuthenticated();
        allow create: if isRegistered()
                      && request.auth.uid == uid
                      && isValidReview(placeId, uid)
                      && request.resource.data.hidden == false;
        allow update: if isRegistered() && (
          (
            request.auth.uid == uid
            && isValidReview(placeId, uid)
            && request.resource.data.hidden == resource.data.hidden
            && request.resource.data.createdAt == resource.data.createdAt
          ) ||
          (
            request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
            && request.resource.data.hidden == true
          )
        );
        allow delete: if isRegistered() && request.auth.uid == uid;

        // Reports are read only in the console.
        match /reports/{reporterUid} {
          allow create: if isRegistered()
                        && request.auth.uid == reporterUid
                        && reporterUid != uid
                        && request.resource.data.keys().hasOnly(['createdAt']);
        }
      }
    }

    // Collection-group read of the caller's own reviews, so deleting an
    // account can find them (needs the reviews.uid field override in
    // firestore.indexes.json). Deleting uses the rule above.
    match /{path=**}/reviews/{uid} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Curated cities, written only by the import tool. importRuns has no
    // rule, so clients can neither read nor write it.
    match /cities/{cityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /placeCacheMetadata/{cityKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Solo-mode swipe history, private to its author.
    match /swipeResults/{resultId} {
      allow read, delete: if isAuthenticated()
                          && request.auth.uid == resource.data.userId;
      allow create, update: if isAuthenticated()
                            && request.auth.uid == request.resource.data.userId;
    }

    // Invite code -> group, plus the trip name, city and owner's first name
    // for the web invite preview. Anyone signed in may look up a code they
    // know (get), nobody may list codes. Only the group's owner writes the entry,
    // and only for the group's current code.
    match /inviteCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt', 'title', 'cityName', 'ownerName'])
        && request.resource.data.groupId is string
        // Shown on the web invite before joining; short plain strings only.
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
        && (!('cityName' in request.resource.data) || (request.resource.data.cityName is string && request.resource.data.cityName.size() <= 80))
        && (!('ownerName' in request.resource.data) || (request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 60))
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.invite.code == code;
      allow delete: if isAuthenticated()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      // Members only. Invite codes are resolved through /inviteCodes, so
      // nobody needs to read or list a group before joining it.
      allow read: if isAuthenticated() && isMember(resource.data);

      // A creator may only create a group containing themselves.
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.resource.data.members.size() == 1
                    && request.auth.uid in request.resource.data.members;

      allow update: if isAuthenticated() && (
        // Owner can update anything (name, dates, location, invite, ...)
        isOwner(resource.data) ||
        // A member may refresh the shared-favourites projection.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sharedFavorites'
          ])
        ) ||
        // Joining: only the caller may be appended, and only themselves,
        // only with the group's invite code (sent as joinCode). Any time:
        // the swipe deck stays open, so there is no round to wait for.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode']) &&
          request.resource.data.get('joinCode', '') == resource.data.invite.code &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        ) ||
        // Any member may (re)build the trip's day plan from the wishlist.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripPlan']) &&
          request.resource.data.tripPlan.days is list &&
          request.resource.data.tripPlan.days.size() <= 14
        ) ||
        // Leaving: the caller may only remove themselves.
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          !request.resource.data.members.hasAny([request.auth.uid]) &&
          resource.data.members.hasAll(request.resource.data.members)
        )
      );

      allow delete: if isOwner(resource.data);

      // --- Trip planning (ideas, polls, expenses) ---

      // Wishlist idea. likedBy may only change by the caller's own uid.
      match /ideas/{ideaId} {
        allow read: if isMember(groupData(groupId));
        allow create: if isMember(groupData(groupId))
                      && isValidIdea(request.resource.data)
                      && request.resource.data.addedBy == request.auth.uid
                      && request.resource.data.likedBy.hasOnly([request.auth.uid]);
        allow update: if isMember(groupData(groupId))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                      && request.resource.data.likedBy is list
                      && onlyOwnUidToggled(resource.data.likedBy, request.resource.data.likedBy);
        allow delete: if isMember(groupData(groupId))
                      && (resource.data.addedBy == request.auth.uid
                          || isOwner(groupData(groupId)));
      }

      // Poll. votes is a map uid -> option id: one vote per member, and a
      // member may only set or remove their own entry.
      match /polls/{pollId} {
        allow read: if isMember(groupData(groupId));
        allow create: if isMember(groupData(groupId))
                      && isValidPoll(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.votes.size() == 0
                      && request.resource.data.closed == false;
        allow update: if isMember(groupData(groupId)) && (
          (
            resource.data.closed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes is map
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.votes)
                || request.resource.data.votes[request.auth.uid] is string)
          ) ||
          (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
            && request.resource.data.closed is bool
          )
        );
        allow delete: if isMember(groupData(groupId))
                      && (resource.data.createdBy == request.auth.uid
                          || isSoleOwner(groupId));
      }

      // Shared expense in integer cents. Editable and deletable by its creator.
      match /expenses/{expenseId} {
        allow read: if isMember(groupData(groupId));
        allow create: if isMember(groupData(groupId))
                      && isValidExpense(request.resource.data, groupData(groupId))
                      && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(groupData(groupId))
                      && resource.data.createdBy == request.auth.uid
                      && isValidExpense(request.resource.data, groupData(groupId))
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(groupData(groupId))
                      && (resource.data.createdBy == request.auth.uid
                          || isSoleOwner(groupId));
      }

      // Journal entry. Edited by its author (text only in the app); deleted
      // by its author or the trip owner (also when clearing the trip).
      match /journal/{entryId} {
        allow read: if isMember(groupData(groupId));
        allow create: if isMember(groupData(groupId))
                      && isValidJournalEntry(request.resource.data)
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.createdAt == request.time;
        allow update: if isMember(groupData(groupId))
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'photos', 'updatedAt'])
                      && isValidJournalEntry(request.resource.data);
        allow delete: if isMember(groupData(groupId))
                      && (resource.data.authorUid == request.auth.uid
                          || isOwner(groupData(groupId)));
      }

      // Swipe deck: one document per member with their votes (place id ->
      // 0 nope, 1 like, 2 super-like) and their one veto. Only the member
      // writes it; matches are worked out in the app from all of them.
      match /swipes/{uid} {
        allow read: if isMember(groupData(groupId));
        allow create, update: if isMember(groupData(groupId))
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['votes', 'veto', 'updatedAt'])
                              && request.resource.data.votes is map
                              && request.resource.data.votes.size() <= 1000
                              && (request.resource.data.get('veto', null) == null
                                  || (request.resource.data.veto is string
                                      && request.resource.data.veto.size() <= 200));
        // Also when leaving the trip; the owner when clearing it.
        allow delete: if request.auth.uid == uid || isOwner(groupData(groupId));
      }

      // Swipe rounds of earlier versions, replaced by /swipes. Nothing
      // writes them anymore; readable and deletable so old data can go.
      match /sessions/{document=**} {
        allow read: if isMember(groupData(groupId));
        allow delete: if isOwner(groupData(groupId));
      }
    }
  }
}
