rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(groupData) {
      return isAuthenticated() && request.auth.uid == groupData.ownerUid;
    }
    
    function isMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.members;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Anyone can read a group to join it via invite, or if they are a member
      allow read: if isAuthenticated();
      
      // Creating a group: user must be the owner and in the members list
      allow create: if isAuthenticated() 
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.auth.uid in request.resource.data.members;
                    
      // Updating a group
      allow update: if isAuthenticated() && (
        // Owner can update anything (like threshold, location, etc.)
        isOwner(resource.data) ||
        // Members can mark a session as completed by clearing activeSessionId
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activeSessionId',
            'hasCompletedSession'
          ]) &&
          request.resource.data.activeSessionId == null &&
          request.resource.data.hasCompletedSession == true
        ) ||
        // Users can join if joinEnabled is true and they use a valid invite (handled by backend or validating fields here)
        // A simple rule is to allow appending to members if joinEnabled == true
        (
          resource.data.joinEnabled == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) // Only adding members
        ) ||
        // Allow removing oneself from the group
        (
          isMember(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          !request.resource.data.members.hasAny([request.auth.uid])
        )
      );
      
      allow delete: if isOwner(resource.data);

      match /sessions/{sessionId} {
        // Members can read sessions
        allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        
        // Only owner can create a session
        allow create: if isOwner(get(/databases/$(database)/documents/groups/$(groupId)).data);
        
        // Updating a session
        allow update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data) && (
          // Owner can update status (e.g. end session early)
          isOwner(get(/databases/$(database)/documents/groups/$(groupId)).data) ||
          // Members can update progressByUser
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progressByUser', 'isCompleted'])
        );
        
        allow delete: if isOwner(get(/databases/$(database)/documents/groups/$(groupId)).data);

        match /votes/{placeId} {
          // Members can read and cast votes
          allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
          
          allow create, update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data) && (
            // User can only update their own vote or the aggregate count (using FieldValue.increment)
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'downvotes', 'votedUsers'])
            // Ideally, we ensure votedUsers array appending is valid, but Firestore rules are limited for complex array diffs.
          );
        }
      }
    }
  }
}
